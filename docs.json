{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "install.md",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Specification",
            "pages": [
              "essentials/format",
              "essentials/examples",
              "essentials/integration"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "essentials/contributing"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/mintlify/install-md",
          "icon": "github"
        },
        {
          "anchor": "Community",
          "href": "https://github.com/mintlify/install-md/discussions",
          "icon": "comments"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/mintlify/install-md"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify/install-md",
      "linkedin": "https://www.linkedin.com/company/mintlify/"
    }
  }
}
