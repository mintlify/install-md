{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "install.md",
  "colors": {
    "primary": "#1EA454",
    "light": "#5BC97A",
    "dark": "#178F48"
  },
  "font": {
    "family": "Recursive",
    "headings": "Recursive"
  },
  "css": "/custom.css",
  "rounded": "none",
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Specification",
            "pages": [
              "essentials/format",
              "essentials/examples"
            ]
          },
          {
            "group": "Skills",
            "pages": [
              "essentials/skills"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/mintlify/install-md",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/install-md-logo-dark.svg",
    "dark": "/logo/install-md-logo-light.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/mintlify/install-md"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify/install-md",
      "linkedin": "https://www.linkedin.com/company/mintlify/"
    }
  }
}
